<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Polaris.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Polaris.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Polaris"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="AcrylicBlur">

    <Window.Styles>
        
        <!-- SIDEBAR STYLING -->
        <Style Selector="ListBox.sidebar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style Selector="ListBox.sidebar ListBoxItem" x:DataType="vm:SidebarEntry">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="IsEnabled" Value="{Binding isSelectable}" />
        </Style>

        <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="ListBox.siderbar ListBoxItem:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

    </Window.Styles>

    <SplitView  IsPaneOpen="{Binding IsSidebarOpen}"
                DisplayMode="Inline"
                OpenPaneLength="240"
                PaneBackground="{StaticResource SidebarBrush}"> <!-- Refer to Application.Resources -->

        <SplitView.Pane>

            <!-- TEMPORARY -->
            <ListBox    Classes="sidebar"
                        ItemsSource="{Binding SidebarEntries}"
                        SelectedItem="{Binding SelectedEntry}">
                
                <ListBox.DataTemplates>

                    <DataTemplate DataType="vm:SidebarHeader">
                        <TextBlock Classes="muted" FontSize="11" Margin="0,12,0,2" Text="{Binding Title}" />
                    </DataTemplate>

                    <DataTemplate DataType="vm:SidebarItem">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Data="{Binding Icon}" Width="14" Height="14" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="13" VerticalAlignment="Center" Classes="muted" />
                        </Grid>
                    </DataTemplate>

                </ListBox.DataTemplates>

            </ListBox>

        </SplitView.Pane>

        <Grid RowDefinitions="52,*" Background="{StaticResource ContentBrush}">

            <TextBlock Grid.Row="0" Background="Blue" />
            <TextBlock Grid.Row="1" Background="Red" />

            <Grid x:Name="Toolbar" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Background="Black" />

        </Grid>

    </SplitView>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

</Window>
